# Set an explicit database name in the URI path; do not omit it (Mongoose would use `test`).
# Example only: mongodb://<username>:<password>@localhost:27017/scoreflow?authSource=admin
MONGODB_URI=
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ScoreFlow
# Configure Brevo's transactional webhook with HTTP Basic auth using these values.
BREVO_WEBHOOK_USERNAME=
BREVO_WEBHOOK_PASSWORD=
